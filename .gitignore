# Build output
build/
.gradle/
.kotlin/
*.apk
*.aab

# Local config and secrets
local.properties
.env
.env.*
!.env.example
*.keystore
*.jks

# Tooling
.idea/
*.iml
.DS_Store
node_modules/

# Agent scratch space, and the editor's local commands
.agent-tmp/
.claude/

# The backend's saved data (guardians' link hashes and Peri's news)
backend/data/

# Evaluation data with real (even anonymised) messages stays local
eval/data/
training/data/
# The red team's messages and raw answers: made up, but a made-up number or address may belong to someone real
eval/redteam/*/mensajes.tsv
eval/redteam/*/raw/

# Demo video clips: large, they go to the video host, not the repo
dist/demo/

# The ad's recordings and renders (video/): large, made again with video/scripts/record.sh and npm run render
video/public/clips/
video/out/

# Python caches from the asset scripts
__pycache__/
# The draft voiceover (Windows voice): made again from video/public/voice/lines.json, never committed
video/public/voice/*.wav
video/public/cut/

# The edit's working files (video/scripts/editar.ps1): the person's voice, cut up; made again from the recording
video/trabajo/
video/public/voice/borrador/

# The videos' pictures, voices, music and sounds (video/scripts: *_images.ts, *_visemes.ts, *_voice.py, *_music.py,
# *_sfx.py, peri_app.py): about 1.4 GB, kept on the computer that renders. Their prompts, lines and mouth timings
# (the .json beside them) stay in the repo.
video/public/**/*.png
video/public/**/*.wav
video/public/**/*.mp3
video/public/peri7/
