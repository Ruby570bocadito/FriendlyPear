<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions are added feature by feature, each reviewed by SEG. None gives access to call audio. -->
    <!-- Voice orders. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Who is family, to check "new number" messages. Read on the phone, never sent. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Whether a call is in progress (code during a call). Not the audio. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- Calling the real family member, always after a spoken "yes". -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <!-- Messages the person dictates and the emergency alert. -->
    <uses-permission android:name="android.permission.SEND_SMS" />
    <!-- Incoming SMS in full: Android 15+ hides one-time codes from notification listeners. -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <!-- Only for the emergency SMS. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Which app is in front, only during a picked-up call: a bank app opened while a stranger is on the line. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- Mini Peri: the pear floating over other apps, with a notification while she's out. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- So Mini Peri can listen when tapped while another app is in front; never on her own. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Only doubtful messages, to the family backend for a second opinion. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <queries>
        <!-- Remote-control apps scammers ask people to install (same list as core RemoteApps). -->
        <package android:name="com.anydesk.anydeskandroid" />
        <package android:name="com.teamviewer.quicksupport.market" />
        <package android:name="com.teamviewer.host.market" />
        <package android:name="com.teamviewer.teamviewer.market.mobile" />
        <package android:name="com.rustdesk.rustdesk" />
        <package android:name="com.carriez.flutter_hbb" />
        <package android:name="com.sand.airdroid" />
        <package android:name="com.sand.airdroidbiz" />
        <package android:name="com.sand.airmirror" />
        <package android:name="com.splashtop.sos" />
        <package android:name="com.splashtop.streamer.addon.knox" />
        <package android:name="com.zoho.assist.agent" />
        <package android:name="com.logmein.rescuemobile" />
        <package android:name="com.realvnc.server" />
        <package android:name="com.supremocontrol.supremo" />
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".PeriApp"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.FriendlyPear">

        <activity
            android:name=".ui.peri.PeriActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".services.MessageListener"
            android:exported="true"
            android:label="@string/listener_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <activity
            android:name=".ui.peri.FamilyActivity"
            android:exported="false"
            android:label="@string/family_title" />

        <!-- Sees incoming numbers before pickup to warn about strangers; never blocks or hears the call. -->
        <service
            android:name=".services.CallScreener"
            android:exported="true"
            android:permission="android.permission.BIND_SCREENING_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>

        <service
            android:name=".ui.peri.MiniPeriService"
            android:exported="false"
            android:foregroundServiceType="microphone|specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Floating assistant the person turned on, shown over other apps until they put it away" />
        </service>

        <receiver
            android:name=".services.SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
