# Backend port
PORT=8787
# Random secret shared with the phone (>= 32 chars)
DEVICE_TOKEN=
# Optional: a separate secret (>= 32 chars) for `bun pair` and for listing or disconnecting phones
ADMIN_TOKEN=
# 0 once every phone is paired with its own key (`bun pair`): the shared DEVICE_TOKEN then stops working
ALLOW_SHARED_TOKEN=
# Public origin for the guardian approval links
PUBLIC_BASE_URL=http://localhost:8787
# Behind a tunnel or reverse proxy: 1 to take the client IP from X-Forwarded-For (for the rate limits)
TRUST_PROXY=
# Where the guardians' link hashes and Peri's news are saved (git-ignored)
DATA_DIR=data
# Meta Model API (Muse Spark investigator, "look at this picture" with SAM 3.1). Empty: those layers are off.
META_API_BASE=https://api.meta.ai/v1
META_API_KEY=
# Baseten Model APIs, for the Muse Spark Open second opinion. Empty: that layer is off.
BASETEN_API_KEY=
# Muse Glimmer endpoint (local or partner)
GLIMMER_BASE_URL=
