# Backend port
PORT=8787
# Random secret shared with the phone (>= 32 chars)
DEVICE_TOKEN=
# Public origin for the guardian approval links
PUBLIC_BASE_URL=http://localhost:8787
# Meta Model API (Muse Spark, Voice Transcribe, SAM 3.1). Leave empty to run with on-device rules only.
META_API_BASE=
META_API_KEY=
# Muse Glimmer endpoint (local or partner)
GLIMMER_BASE_URL=
